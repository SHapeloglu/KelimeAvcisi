{
  "manifest_version": 3,
  "name": "Kelime Avcısı Pro",
  "version": "1.3",
  "description": "Sağ tıkla kelime ekle, anlamını yaz ve 5 dakikada bir hatırla!",
  "permissions": [
    "contextMenus",
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}